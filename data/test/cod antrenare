# 1. Instalam YOLO (biblioteca ultralytics)
%pip install ultralytics
import ultralytics
from ultralytics import YOLO
import zipfile
import os
import yaml

# ==========================================
# CONFIGURARE
# ==========================================
ARHIVA_DATASET = "dataset_gata.zip"  # Asigura-te ca ai incarcat fisierul asta!
NUMAR_EPOCI = 200                    
# ==========================================

# 2. Dezarhivam dataset-ul
print("⏳ Dezarhivez dataset-ul...")
if not os.path.exists(ARHIVA_DATASET):
    print(f"❌ EROARE: Nu gasesc {ARHIVA_DATASET}. Urca-l in stanga!")
else:
    with zipfile.ZipFile(ARHIVA_DATASET, 'r') as zip_ref:
        zip_ref.extractall("/content/my_dataset")
    print("✅ Dezarhivare completa!")

# 3. Rescriem data.yaml cu cai ABSOLUTE (ca sa nu avem erori de "file not found")
yaml_path = "/content/my_dataset/data.yaml"

# Verificam ce nume de clasa ai pus (daca nu stii, punem 'obiect')
# Daca ai fisierul yaml vechi, il citim, daca nu, cream unul nou standard
try:
    with open(yaml_path, 'r') as f:
        data_config = yaml.safe_load(f)
        names = data_config.get('names', ['obiect'])
except:
    names = ['obiect'] # Fallback

# Continutul sigur care functioneaza in Colab
new_yaml_content = {
    'path': '/content/my_dataset', # Calea de baza
    'train': 'train/images',       # Unde sunt pozele de antrenament
    'val': 'valid/images',         # Unde sunt pozele de validare
    'names': names,                # Numele claselor
    'nc': len(names)               # Numarul de clase
}

with open(yaml_path, 'w') as f:
    yaml.dump(new_yaml_content, f)
print(f"✅ Fisierul data.yaml a fost actualizat corect: {yaml_path}")

# 4. PORNIREA ANTRENAMENTULUI 🚀
print("\n🚀 INCEP ANTRENAMENTUL... Tine-te bine!")
model = YOLO('yolov8n.pt') # Folosim modelul Nano (cel mai rapid)

results = model.train(
    data=yaml_path,
    epochs=NUMAR_EPOCI,
    imgsz=640,
    batch=16,
    name='modelul_meu' # Aici se vor salva rezultatele
)

print("\n🎉 ANTRENAMENT FINALIZAT!")
print("Gasesti modelul antrenat in folderul: runs/detect/modelul_meu/weights/best.pt")
