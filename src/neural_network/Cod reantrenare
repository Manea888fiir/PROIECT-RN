import os
import shutil
import zipfile
import yaml
from pathlib import Path
from ultralytics import YOLO

# --- CONFIGURARE ---
# Pune numele EXACT al arhivei pe care o ai in stanga (cea cu train/valid/test)
ARHIVA_DATASET = "dataset_split_70_15_15.zip" 
MODEL_START = "SIA BUN.pt" 
NUMAR_EPOCI = 200
RABDARE = 5
# -------------------

def main():
    base_dir = Path("/content")
    # Facem un folder nou 'my_dataset' ca sa nu il confundam cu temp_extract vechi
    dataset_dir = base_dir / "my_dataset_ready"

    # 1. Verificari
    if not os.path.exists(ARHIVA_DATASET):
        print(f"❌ NU GASESC ARHIVA: {ARHIVA_DATASET}")
        print("Verifica numele fisierului din meniul din stanga!")
        return
    
    if not os.path.exists(MODEL_START):
        print(f"❌ NU GASESC MODELUL: {MODEL_START}")
        return

    # 2. Curatenie si Dezarhivare
    if dataset_dir.exists(): shutil.rmtree(dataset_dir)
    
    print(f"⏳ Dezarhivez {ARHIVA_DATASET}...")
    with zipfile.ZipFile(ARHIVA_DATASET, 'r') as zip_ref:
        zip_ref.extractall(dataset_dir)

    # 3. Cautam fisierul data.yaml (poate fi intr-un subfolder)
    yaml_files = list(dataset_dir.rglob("data.yaml"))
    
    if not yaml_files:
        print("❌ EROARE: Nu am gasit fisierul 'data.yaml' in arhiva!")
        print("Sigur ai urcat arhiva corecta (cea generata anterior)?")
        return
    
    yaml_path = yaml_files[0]
    print(f"✅ Am gasit configuratia in: {yaml_path}")

    # 4. Corectam caile din data.yaml (IMPORTANT pt Colab)
    # Uneori caile sunt relative (../train), noi le facem absolute
    with open(yaml_path, 'r') as f:
        data = yaml.safe_load(f)
    
    # Fortam caile corecte bazate pe unde am gasit yaml-ul
    parent_dir = yaml_path.parent
    data['path'] = str(parent_dir)
    data['train'] = 'train/images'
    data['val'] = 'valid/images'
    data['test'] = 'test/images'
    
    with open(yaml_path, 'w') as f:
        yaml.dump(data, f)
    print("✅ Am actualizat data.yaml cu caile corecte.")

    # 5. RE-ANTRENARE
    print(f"\n🔥 INCEP RE-ANTRENAMENTUL (Fine-Tuning) pe {MODEL_START}...")
    
    model = YOLO(MODEL_START)

    model.train(
        data=str(yaml_path),
        epochs=NUMAR_EPOCI,
        patience=RABDARE,
        batch=16,
        imgsz=640,
        project='/content/runs/detect',
        name='SIA_REANTRENAT_FINAL',
        exist_ok=True
    )

    # 6. Test Final
    print("\n🎓 Testare finală...")
    best_path = '/content/runs/detect/SIA_REANTRENAT_FINAL/weights/best.pt'
    
    if os.path.exists(best_path):
        final_model = YOLO(best_path)
        metrics = final_model.val(split='test')
        print(f"\nREZULTAT FINAL (mAP50): {metrics.box.map50:.2%}")
    else:
        print("❌ Ceva nu a mers la antrenament.")

if __name__ == "__main__":
    main()
