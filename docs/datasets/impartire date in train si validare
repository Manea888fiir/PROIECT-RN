import os
import shutil
import random
import zipfile
from pathlib import Path
from google.colab import files

# ================= CONFIGURARE =================
ARHIVA_SURSA = "dataset intreg.zip"  # Numele exact al arhivei tale
ARHIVA_FINALA = "dataset_split_70_15_15.zip"

# Structura interioara (cum ai zis tu)
FOLDER_INTERIOR = "dataset"          # Folderul principal din arhiva
SUBFOLDER_IMAGINI = "imagini"        # Unde sunt pozele
SUBFOLDER_ETICHETE = "labels"        # Unde sunt txt-urile

RATII = (0.70, 0.15, 0.15)           # 70% Train, 15% Valid, 15% Test
# ===============================================

def proceseaza_dataset_structurat():
    base_dir = Path("/content")
    temp_extract = base_dir / "temp_extract"
    dataset_dir = base_dir / "dataset_final"
    
    # 1. Curatenie
    if temp_extract.exists(): shutil.rmtree(temp_extract)
    if dataset_dir.exists(): shutil.rmtree(dataset_dir)
    
    # 2. Dezarhivam
    if not os.path.exists(ARHIVA_SURSA):
        print(f"❌ EROARE: Nu găsesc '{ARHIVA_SURSA}'! Urcă arhiva în stânga.")
        return

    print("⏳ Dezarhivez arhiva...")
    with zipfile.ZipFile(ARHIVA_SURSA, 'r') as zip_ref:
        zip_ref.extractall(temp_extract)

    # 3. Construim caile catre folderele extrase
    # Cautam folderul 'dataset' in ce am extras
    # Uneori zip-ul creaza un folder parinte in plus, asa ca il cautam recursiv
    found_img_dir = list(temp_extract.rglob(SUBFOLDER_IMAGINI))
    found_lbl_dir = list(temp_extract.rglob(SUBFOLDER_ETICHETE))

    if not found_img_dir or not found_lbl_dir:
        print(f"❌ EROARE STRUCTURA: Nu am gasit folderele '{SUBFOLDER_IMAGINI}' sau '{SUBFOLDER_ETICHETE}' in arhiva.")
        return
    
    # Luam primele gasite (de obicei sunt corecte)
    path_img = found_img_dir[0]
    path_lbl = found_lbl_dir[0]
    
    print(f"📂 Am localizat imaginile în: {path_img}")
    print(f"📂 Am localizat etichetele în: {path_lbl}")

    # 4. Imperechem fisierele (Poza din folder A + Txt din folder B)
    pairs = []
    extensii_img = ['.jpg', '.jpeg', '.png', '.bmp', '.JPG', '.PNG']
    
    files_in_img = list(path_img.iterdir())
    
    for img_file in files_in_img:
        if img_file.suffix in extensii_img:
            # Cautam eticheta cu acelasi nume in folderul de labels
            # Ex: dataset/imagini/poza1.jpg  --> cautam dataset/labels/poza1.txt
            txt_name = img_file.stem + ".txt"
            txt_file = path_lbl / txt_name
            
            if txt_file.exists():
                pairs.append((img_file, txt_file))
            else:
                # Optional: afisam daca lipseste eticheta
                # print(f"⚠️ Lipsă etichetă pentru: {img_file.name}")
                pass
    
    total_files = len(pairs)
    if total_files == 0:
        print("❌ Nu am găsit nicio pereche validă (Poza+Txt). Verifică numele fișierelor!")
        return

    print(f"✅ Am găsit {total_files} perechi valide.")

    # 5. Amestecam si Impartim
    random.shuffle(pairs)
    
    train_end = int(total_files * RATII[0])
    valid_end = int(total_files * (RATII[0] + RATII[1]))
    
    train_set = pairs[:train_end]
    valid_set = pairs[train_end:valid_end]
    test_set = pairs[valid_end:]
    
    print(f"📊 Statistici split:")
    print(f"   Train: {len(train_set)}")
    print(f"   Valid: {len(valid_set)}")
    print(f"   Test:  {len(test_set)}")

    # 6. Cream structura finala YOLO
    splits = ['train', 'valid', 'test']
    for split in splits:
        (dataset_dir / split / 'images').mkdir(parents=True, exist_ok=True)
        (dataset_dir / split / 'labels').mkdir(parents=True, exist_ok=True)

    # 7. Copiem fisierele la locul lor
    def muta_fisiere(lista_perechi, tip_split):
        for img, txt in lista_perechi:
            shutil.copy(img, dataset_dir / tip_split / 'images' / img.name)
            shutil.copy(txt, dataset_dir / tip_split / 'labels' / txt.name)
            
    print("🚀 Copiez fișierele în noua structură...")
    muta_fisiere(train_set, 'train')
    muta_fisiere(valid_set, 'valid')
    muta_fisiere(test_set, 'test')
    
    # 8. Generam data.yaml
    yaml_content = f"""
path: ../dataset_final
train: train/images
val: valid/images
test: test/images

nc: 1
names: ['obiect']
"""
    with open(dataset_dir / 'data.yaml', 'w') as f:
        f.write(yaml_content)

    # 9. Arhivam si Descarcam
    print("📦 Creez arhiva finală...")
    shutil.make_archive("/content/dataset_split_70_15_15", 'zip', dataset_dir)
    
    print(f"🎉 GATA! Descarc {ARHIVA_FINALA}...")
    files.download(f"/content/{ARHIVA_FINALA}")

if __name__ == "__main__":
    proceseaza_dataset_structurat()
